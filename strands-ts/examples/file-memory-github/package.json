{
  "name": "file-memory-github",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "prepare": "npm ci --prefix ../../..",
    "clean": "rm -rf dist node_modules package-lock.json",
    "build": "tsc",
    "demo": "tsc && node --env-file-if-exists=.env dist/demo.js",
    "start": "tsc && node --env-file-if-exists=.env dist/seed.js",
    "ask": "tsc && node --env-file-if-exists=.env dist/ask.js",
    "consolidate": "tsc && node --env-file-if-exists=.env dist/consolidate.js"
  },
  "workspaces": [
    "../../"
  ],
  "dependencies": {
    "@strands-agents/sdk": "*",
    "@octokit/rest": "^22.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
