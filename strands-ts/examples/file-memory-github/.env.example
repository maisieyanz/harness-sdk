# Copy to .env and fill in. The npm scripts load .env automatically; it is gitignored.
#
# Never commit real credentials. AWS values below are short-lived session credentials,
# not long-term keys — see the README for how to refresh them.

# --- GitHub: the repository used as the memory store ---
# A fine-grained token scoped to the repo with Contents: Read and write.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# GITHUB_BRANCH=main

# --- Bedrock ---
# Omit the AWS_* keys entirely if the default credential chain already works for you
# (a profile, an assumed role, an instance role).
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Command ./refresh-env.sh runs to reissue the three AWS_* values above.
# CREDENTIAL_COMMAND=aws configure export-credentials

# MODEL_ID=global.anthropic.claude-sonnet-5

# Set to 1 on a role granted bedrock:InvokeModel but not
# bedrock:InvokeModelWithResponseStream — switches to the non-streaming Converse API.
BEDROCK_NO_STREAM=1
